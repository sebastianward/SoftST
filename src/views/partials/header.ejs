<header class="site-header">
  <div class="brand-wrap">
    <a class="brand brand-logo" href="/">
      <img src="/public/img/logo-antalis-tem.svg" alt="Antalis TEM">
    </a>
    <div class="brand-text">
      <a class="brand" href="/">Registro Ingresos</a>
    </div>
  </div>

  <% if (currentUser) { %>
    <nav class="top-nav">
      <div class="top-nav-links">
        <a href="/">Inicio</a>
        <a href="/entries">Ingresos</a>
        <a href="/entries/new">Nuevo ingreso</a>
        <% if (showVehiclesModule) { %>
          <a href="/camionetas">Camionetas</a>
        <% } %>
      </div>
      <div class="top-nav-tools">
        <div class="header-utility-cluster">
          <% if (currentUser.role === "admin") { %>
            <div class="area-switcher">
              <% areaOptions.forEach((areaOption) => { %>
                <a class="area-chip header-control <%= currentArea === areaOption.value ? "is-active" : "" %>" href="/admin/switch-area/<%= areaOption.value %>">
                  <%= areaOption.label %>
                </a>
              <% }) %>
            </div>
            <a class="notification-link" href="/notifications" aria-label="Notificaciones">
              <span class="bell">&#128276;</span>
              <% if (notificationCount > 0) { %>
                <span class="badge"><%= notificationCount %></span>
              <% } else { %>
                <span class="badge is-empty">0</span>
              <% } %>
            </a>
            <div class="account-menu">
              <button class="ghost-button header-control header-icon-button" type="button" data-menu-toggle aria-haspopup="true" aria-expanded="false" aria-label="Configuracion" title="Configuracion">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path d="M19.14 12.94c.04-.31.06-.63.06-.94s-.02-.63-.06-.94l2.03-1.58a.5.5 0 0 0 .12-.64l-1.92-3.32a.5.5 0 0 0-.6-.22l-2.39.96a7.03 7.03 0 0 0-1.63-.94l-.36-2.54a.5.5 0 0 0-.5-.42h-3.84a.5.5 0 0 0-.5.42l-.36 2.54c-.58.23-1.13.54-1.63.94l-2.39-.96a.5.5 0 0 0-.6.22L2.71 8.84a.5.5 0 0 0 .12.64l2.03 1.58c-.04.31-.06.63-.06.94s.02.63.06.94l-2.03 1.58a.5.5 0 0 0-.12.64l1.92 3.32a.5.5 0 0 0 .6.22l2.39-.96c.5.4 1.05.72 1.63.94l.36 2.54a.5.5 0 0 0 .5.42h3.84a.5.5 0 0 0 .5-.42l.36-2.54c.58-.23 1.13-.54 1.63-.94l2.39.96a.5.5 0 0 0 .6-.22l1.92-3.32a.5.5 0 0 0-.12-.64l-2.03-1.58ZM12 15.5A3.5 3.5 0 1 1 12 8.5a3.5 3.5 0 0 1 0 7Z" fill="currentColor"></path>
                </svg>
              </button>
              <div class="account-menu-panel settings-menu-panel" data-menu-panel hidden>
                <a class="settings-menu-link" href="/settings">Configuracion</a>
                <a class="settings-menu-link" href="/workers">Trabajadores</a>
              </div>
            </div>
          <% } %>
          <div class="account-menu">
            <button class="user-chip header-control account-menu-toggle" type="button" data-menu-toggle aria-haspopup="true" aria-expanded="false">
              <%= currentUser.username %>
            </button>
            <div class="account-menu-panel" data-menu-panel hidden>
              <button class="ghost-button account-menu-action" type="button" data-theme-toggle aria-label="Cambiar tema">
                <span data-theme-label>Modo claro</span>
              </button>
              <button class="ghost-button account-menu-action" type="button" data-open-password-modal>Cambiar clave</button>
              <form action="/logout" method="post" class="account-menu-form">
                <button class="ghost-button account-menu-action" type="submit">Salir</button>
              </form>
            </div>
          </div>
        </div>
      </div>
    </nav>
  <% } %>
</header>

<% if (flash) { %>
  <div class="flash flash-<%= flash.type %>"><%= flash.message %></div>
<% } %>

<% if (currentUser) { %>
  <div class="image-modal" id="passwordModal" hidden>
    <div class="image-modal-backdrop" data-close-password-modal></div>
    <div class="image-modal-dialog password-modal-dialog">
      <button type="button" class="image-modal-close" data-close-password-modal>Cerrar</button>
      <h2>Cambiar contrasena</h2>
      <form action="/account/password" method="post" class="stack-form">
        <label>
          Contrasena actual
          <input type="password" name="currentPassword" autocomplete="current-password" required>
        </label>
        <label>
          Nueva contrasena
          <input type="password" name="newPassword" autocomplete="new-password" minlength="8" required>
        </label>
        <label>
          Repite la nueva contrasena
          <input type="password" name="confirmPassword" autocomplete="new-password" minlength="8" required>
        </label>
        <div class="comment-modal-actions">
          <button type="button" class="ghost-button" data-close-password-modal>Cancelar</button>
          <button type="submit">Guardar nueva clave</button>
        </div>
      </form>
    </div>
  </div>
<% } %>
