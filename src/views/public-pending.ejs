<%- include("partials/head", { title: "Pendientes" }) %>

<main class="page-shell public-pending-shell">
  <section class="panel public-pending-panel">
    <div class="panel-title">
      <div>
        <h1>Pendientes | <%= publicAreaLabel %></h1>
        <span>Vista publica de ingresos pendientes de asignar y no eliminados.</span>
      </div>
      <span><%= entries.length %> registros</span>
    </div>

    <div class="workers-toolbar">
      <label class="workers-search">
        <input type="search" id="entrySearch" placeholder="Buscar pendiente por cualquier campo">
      </label>
    </div>

    <% if (entries.length === 0) { %>
      <p class="empty-state">No hay pendientes por mostrar.</p>
    <% } else { %>
      <div class="entries-scrollbar-top" data-entries-scrollbar-top aria-hidden="true">
        <div class="entries-scrollbar-top-track" data-entries-scrollbar-top-track></div>
      </div>
      <div class="table-wrap entries-table-wrap public-pending-table-wrap">
        <table class="entries-table public-pending-table" id="entriesTable">
          <thead>
            <tr>
              <th>ID</th>
              <th>Estado</th>
              <th>Fecha</th>
              <th>Empresa</th>
              <th>RUT</th>
              <th>Contacto</th>
              <th>Equipo</th>
              <th>Ingresado por</th>
              <th>Creado por</th>
            </tr>
          </thead>
          <tbody>
            <% entries.forEach((entry) => { %>
              <% const searchable = [
                entry.id,
                entry.entry_status,
                entry.business_name,
                entry.rut,
                entry.contact_name,
                entry.equipment_model,
                entry.worker_name_snapshot,
                entry.created_by_username,
                entry.created_at
              ].join(" ").toLowerCase(); %>
              <tr data-entry-row data-search="<%= searchable %>">
                <td>#<%= entry.id %></td>
                <td><span class="status-pill"><%= entryStatuses.find((status) => status.value === entry.entry_status)?.label || entry.entry_status %></span></td>
                <td><%= entry.created_at %></td>
                <td><%= entry.business_name %></td>
                <td><%= entry.rut %></td>
                <td><%= entry.contact_name %></td>
                <td><%= entry.equipment_model %></td>
                <td><%= entry.worker_name_snapshot %></td>
                <td><%= entry.created_by_username %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </section>
</main>

<%- include("partials/foot") %>
